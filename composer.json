{
  "name": "group6/clinic-management-system",
  "description": "Enterprise-Grade Object-Oriented Clinic Management & PHP Debugging System (Group 6)",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Group 6 Architecture Team",
      "email": "dev@clinicmanagement.org"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4 || ^8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "ClinicManagement\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ClinicManagement\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/clinic.php"
  ],
  "scripts": {
    "cli": "php bin/clinic.php",
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse -l 8 src"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}

